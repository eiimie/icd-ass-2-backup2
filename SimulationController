import javax.swing.*;
import java.awt.*;
import java.util.*;
import java.util.List; 
import java.util.ArrayList;

// coordinates the simulation loop and handles communication between workers
// never directly touches worker state, everything goes through messages 
public class SimulationController {

    private static final int WIDTH = 1280;
    private static final int HEIGHT = 720;
    private static final int NUMBER_OF_CIRCLES = 500000;
    private static final int NUMBER_OF_WORKERS = 4;
    private static final int MAX_ITERATIONS = 10_000_000;
    private static final int QUEUE_CAPACITY = 10000;
    private static final int TIMER_DELAY_MS = 20;

    // ── core components 

    private final Region[] regions;
    private final WorkerThread[] workers;
    private final MessageQueue[] inbound;   // main → workers
    private final MessageQueue[] outbound;  // workers → main

    // circleId → [id, x, y, radius, r, g, b]
    private final Map<Integer, double[]> globalState = new HashMap<>();

    private final Renderer renderer;

    private int iteration = 0;

    // fps tracking
    private int frameCount = 0;
    private long lastFpsTime = System.currentTimeMillis();
    private int fps = 0;

    // ── setup 

    public SimulationController() {
        regions = Region.buildGrid(WIDTH, HEIGHT, NUMBER_OF_WORKERS);

        inbound  = new MessageQueue[NUMBER_OF_WORKERS];
        outbound = new MessageQueue[NUMBER_OF_WORKERS];
        workers  = new WorkerThread[NUMBER_OF_WORKERS];

        for (int i = 0; i < NUMBER_OF_WORKERS; i++) {
            inbound[i]  = new MessageQueue(QUEUE_CAPACITY);
            outbound[i] = new MessageQueue(QUEUE_CAPACITY);

            workers[i] = new WorkerThread(
                i,
                regions[i],
                inbound[i],
                outbound[i],
                WIDTH,
                HEIGHT,
                NUMBER_OF_WORKERS
            );
        }

        renderer = new Renderer(WIDTH, HEIGHT);
    }

    // ── initial population

    private void initialiseCircles() throws InterruptedException {
        Random random = new Random();

        for (int i = 0; i < NUMBER_OF_CIRCLES; i++) {

            int radius = 10;

            double x = random.nextInt(WIDTH - 2 * radius) + radius;
            double y = random.nextInt(HEIGHT - 2 * radius) + radius;

            double dx, dy;
            do {
                dx = random.nextDouble() * 4 - 2;
                dy = random.nextDouble() * 4 - 2;
            } while (dx == 0 && dy == 0);

            int r = random.nextInt(256);
            int g = random.nextInt(256);
            int b = random.nextInt(256);

            int regionIndex = Region.findRegion(x, y, regions);

            inbound[regionIndex].send(
                MessageParser.encodeInit(i, x, y, dx, dy, radius, r, g, b)
            );

            globalState.put(i, new double[]{i, x, y, radius, r, g, b});
        }
    }

    // ── main loop

    private void run() throws InterruptedException {

        while (iteration < MAX_ITERATIONS) {

            // tell all workers to advance one tick
            String tick = MessageParser.encodeTick(iteration);
            for (MessageQueue q : inbound) {
                q.send(tick);
            }

            int finishedWorkers = 0;
            List<String> boundaryMsgs = new ArrayList<>();
            List<String> transferMsgs = new ArrayList<>();

            // collect worker output
            while (finishedWorkers < NUMBER_OF_WORKERS) {
                for (MessageQueue q : outbound) {

                    String msg = q.poll();
                    if (msg == null) continue;

                    switch (MessageParser.getType(msg)) {
                        case "STATE"    -> updateState(msg);
                        case "BOUNDARY" -> boundaryMsgs.add(msg);
                        case "TRANSFER" -> transferMsgs.add(msg);
                        case "DONE"     -> finishedWorkers++;
                    }
                }
            }

            // drain remaining messages
            for (MessageQueue q : outbound) {
                String msg;
                while ((msg = q.poll()) != null) {
                    String type = MessageParser.getType(msg);

                    if (type.equals("STATE")) updateState(msg);
                    else if (type.equals("BOUNDARY")) boundaryMsgs.add(msg);
                    else if (type.equals("TRANSFER")) transferMsgs.add(msg);
                }
            }

            resolveCrossRegionCollisions(boundaryMsgs);
            handleTransfers(transferMsgs);
            pushToRenderer();

            iteration++;
            updateFps();

            if (TIMER_DELAY_MS > 0) {
                Thread.sleep(TIMER_DELAY_MS);
            }
        }

        shutdown();
    }

    // ── message handling

    private void updateState(String msg) {
        double[] parsed = MessageParser.parseIdXYDxDy(msg);

        int id = (int) parsed[0];
        double[] current = globalState.get(id);

        if (current != null) {
            current[1] = parsed[1];
            current[2] = parsed[2];
        }
    }

    private void resolveCrossRegionCollisions(List<String> boundaryMsgs)
            throws InterruptedException {

        List<double[]> circles = new ArrayList<>();

        for (String msg : boundaryMsgs) {
            double[] parsed = MessageParser.parseBoundary(msg);
            int owner = findOwner((int) parsed[0]);

            circles.add(new double[]{
                parsed[0], parsed[1], parsed[2],
                parsed[3], parsed[4], parsed[5],
                owner
            });
        }

        for (int i = 0; i < circles.size(); i++) {
            for (int j = i + 1; j < circles.size(); j++) {

                double[] a = circles.get(i);
                double[] b = circles.get(j);

                if ((int) a[6] == (int) b[6]) continue;

                double dx = b[1] - a[1];
                double dy = b[2] - a[2];
                double dist = Math.sqrt(dx * dx + dy * dy);
                double minDist = a[5] + b[5];

                if (dist > 0 && dist < minDist) {

                    double nx = dx / dist;
                    double ny = dy / dist;

                    double impulse =
                        2 * (a[3]*nx + a[4]*ny - b[3]*nx - b[4]*ny) / 2.0;

                    a[3] -= impulse * nx;
                    a[4] -= impulse * ny;
                    b[3] += impulse * nx;
                    b[4] += impulse * ny;

                    double overlap = minDist - dist;

                    a[1] -= nx * overlap / 2;
                    a[2] -= ny * overlap / 2;
                    b[1] += nx * overlap / 2;
                    b[2] += ny * overlap / 2;

                    inbound[(int) a[6]].send(
                        MessageParser.encodeUpdate((int) a[0], a[1], a[2], a[3], a[4])
                    );

                    inbound[(int) b[6]].send(
                        MessageParser.encodeUpdate((int) b[0], b[1], b[2], b[3], b[4])
                    );
                }
            }
        }
    }

    private void handleTransfers(List<String> transfers) throws InterruptedException {
        for (String msg : transfers) {
            double[] parsed = MessageParser.parseTransfer(msg);

            int target = (int) parsed[9];

            inbound[target].send(
                MessageParser.encodeAssign(
                    (int) parsed[0],
                    parsed[1], parsed[2], parsed[3], parsed[4],
                    (int) parsed[5], (int) parsed[6],
                    (int) parsed[7], (int) parsed[8]
                )
            );
        }
    }

    private int findOwner(int circleId) {
        double[] state = globalState.get(circleId);
        if (state == null) return 0;

        return Region.findRegion(state[1], state[2], regions);
    }

    private void pushToRenderer() {
        double[][] snapshot = new double[globalState.size()][];

        int i = 0;
        for (double[] entry : globalState.values()) {
            snapshot[i++] = entry.clone();
        }

        renderer.updateSnapshot(snapshot, fps, NUMBER_OF_CIRCLES, NUMBER_OF_WORKERS);
        renderer.repaint();
    }

    // ── misc

    private void updateFps() {
        frameCount++;

        long now = System.currentTimeMillis();
        if (now - lastFpsTime >= 1000) {
            fps = frameCount;
            frameCount = 0;
            lastFpsTime = now;
        }
    }

    private void shutdown() throws InterruptedException {
        for (MessageQueue q : inbound) {
            q.send(MessageParser.encodeShutdown());
        }
    }

    // ── entry point

    public static void main(String[] args) {
        SimulationController sim = new SimulationController();

        JFrame frame = new JFrame("Multi-threaded simulation");
        frame.add(sim.renderer);
        frame.pack();
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLocationRelativeTo(null);
        frame.setVisible(true);

        for (WorkerThread w : sim.workers) {
            w.start();
        }

        Thread simThread = new Thread(() -> {
            try {
                sim.initialiseCircles();
                sim.run();
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            }
        });

        simThread.setDaemon(true);
        simThread.start();
    }
}
